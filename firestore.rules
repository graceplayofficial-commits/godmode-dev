rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // channels, videos: 앱에서 읽기만 허용
    match /channels/{channelId} {
      allow read: if true;
      allow write: if false;
    }
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
